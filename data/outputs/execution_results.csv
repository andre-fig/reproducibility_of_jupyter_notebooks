    plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1))
    
    plt.subplot(3, 1, 3)
    for i in range(len(all_epochs)):
        plt.plot(all_epochs[i], all_auc[i], label=file_names[i])
    plt.xlabel('Epoch')
    plt.ylabel('Validation AUC')
    plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1))
    
    plt.tight_layout()
    plt.show()

