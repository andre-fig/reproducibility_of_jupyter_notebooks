# Base image: Python 2.7 slim
FROM python:2.7-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy executor code
WORKDIR /executor
COPY . /executor

# Install minimal dependencies (nbclient may not be available for Python 2.7)
# Use nbconvert as fallback if needed
RUN pip install --no-cache-dir \
    ipython \
    jupyter \
    nbformat \
    ipykernel \
    requests \
    || true

# Try to install nbclient (may fail for Python 2.7)
RUN pip install --no-cache-dir nbclient || echo "nbclient not available for Python 2.7"

# Set environment variables for headless execution
ENV DISPLAY=""
ENV QT_QPA_PLATFORM="offscreen"
ENV SDL_VIDEODRIVER="dummy"
ENV SDL_AUDIODRIVER="dummy"
ENV PYGAME_HIDE_SUPPORT_PROMPT="1"
ENV MPLBACKEND="Agg"
ENV PYTHONWARNINGS="ignore"

# Default entrypoint
ENTRYPOINT ["python", "-m", "scripts.container_worker"]
