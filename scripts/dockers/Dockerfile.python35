# ============================================================================
# Dockerfile para Python 3.5 - Executor de Notebooks Jupyter
# ============================================================================
# 
# PROPÓSITO:
# Esta imagem Docker fornece um ambiente isolado e reprodutível para executar
# notebooks Jupyter coletados do GitHub que requerem Python 3.5. Esta versão
# do Python está obsoleta e muitos pacotes modernos podem não ser compatíveis.
#
# VERSÃO DO PYTHON: 3.5
#
# PACOTES INSTALADOS:
# - Sistema: git, build-essential, gcc, g++, libc6-dev (para compilar extensões)
# - Jupyter: jupyter, nbconvert, nbclient, nbformat, ipykernel
# - Básicos: requests
# - NOTA: Alguns pacotes modernos podem não ser compatíveis com Python 3.5
#   e serão instalados apenas se disponíveis
#
# VARIÁVEIS DE AMBIENTE:
# - TIMEOUT_SECS: Timeout padrão para execução (300s)
# - POLICY: Política de execução (relaxed/strict)
# - NOTEBOOK_DIR: Diretório onde notebooks são montados
# - Variáveis headless: DISPLAY, QT_QPA_PLATFORM, MPLBACKEND, etc.
#
# LIMITAÇÕES:
# - Python 3.5 está obsoleto (EOL desde 2020)
# - Alguns pacotes modernos podem não estar disponíveis
# - Execução em modo headless (sem interface gráfica)
# - Timeout padrão de 300 segundos por notebook
# ============================================================================

FROM python:3.5-slim

# Configurar ambiente não-interativo para evitar prompts durante instalação
ENV DEBIAN_FRONTEND=noninteractive

# Ajustar repositórios APT para usar arquivo Debian (Python 3.5 usa Debian antigo)
# Necessário porque os repositórios padrão do Debian antigo não estão mais disponíveis
RUN set -eux; \
    sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list; \
    sed -i '/security.debian.org/d' /etc/apt/sources.list; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99freeze-check-valid-until

# Atualizar sistema e instalar dependências do sistema
# Estas dependências são necessárias para compilar extensões Python e usar git
RUN apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        gcc \
        g++ \
        libc6-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Criar diretório de trabalho padronizado
WORKDIR /workspace

# Copiar scripts do pipeline para o container
# Os scripts são copiados para /opt/pipeline/scripts para manter organização
COPY scripts /opt/pipeline/scripts
ENV PYTHONPATH="/opt/pipeline:${PYTHONPATH}"

# Instalar pacotes Python básicos compatíveis com Python 3.5
# Usamos || true para permitir que a instalação continue mesmo se alguns pacotes falharem
RUN pip install --no-cache-dir \
    jupyter \
    nbconvert \
    nbclient \
    nbformat \
    ipykernel \
    requests \
    || true

# Configurar variáveis de ambiente para execução headless (sem interface gráfica)
# Essas variáveis garantem que notebooks não tentem abrir janelas gráficas
ENV DISPLAY=""
ENV QT_QPA_PLATFORM="offscreen"
ENV SDL_VIDEODRIVER="dummy"
ENV SDL_AUDIODRIVER="dummy"
ENV PYGAME_HIDE_SUPPORT_PROMPT="1"
ENV MPLBACKEND="Agg"
ENV PYTHONWARNINGS="ignore"

# Variáveis de configuração do executor (podem ser sobrescritas no docker run)
ENV TIMEOUT_SECS=300
ENV POLICY="relaxed"
ENV NOTEBOOK_DIR="/workspace/notebooks"

# Pontos de montagem para notebooks e dados
VOLUME ["/workspace/notebooks", "/workspace/data"]

# Comando padrão: executar o worker do container
# Pode ser sobrescrito com argumentos do docker run
CMD ["python", "-m", "scripts.container_worker"]
